APP_NAME=TBO Inventory Intelligence
APP_ENV=local
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://tbo:tbo_local_password@localhost:5433/tbo_inventory

# Authentication
AUTH_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
SESSION_TTL_MINUTES=720
PASSWORD_RESET_TTL_MINUTES=30
SESSION_COOKIE_NAME=tbo_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
FRONTEND_URL=http://localhost:5173

# Optional SMTP configuration for password-reset emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=
SMTP_USE_TLS=true
